---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Past Hackathons — SURGE NeuroTech Club"
  description="A look back at SURGE NeuroTech Club hackathons."
>
  <section class="hero past-hackathon-hero">
    <div class="container">
      <p class="hero-eyebrow">SURGE NeuroTech Club</p>
      <h1>The Fall 2026 <span>Hackathon</span> Has Concluded!</h1>
      <p class="hero-sub">
        Thanks to all participants, volunteers, and organizers. We look forward to seeing you next time!
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="section-heading">
        <h2>Fall 2026 &mdash; NeuroHackathon</h2>
        <p>September 18&ndash;20, 2026 &middot; Life Sciences Centre</p>
      </div>
      <div class="grid-3">
        <div class="info-card">
          <div class="info-card-label">Streams</div>
          <div class="info-card-value">Machine Learning, Applications, Hardware</div>
        </div>
        <div class="info-card">
          <div class="info-card-label">Prizes</div>
          <div class="info-card-value">$500+ awarded</div>
        </div>
        <div class="info-card">
          <div class="info-card-label">Turnout</div>
          <div class="info-card-value">Open to everyone, free to attend</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm" style="background: var(--color-bg-secondary);">
    <div class="container">
      <div class="recap-placeholder">
        <p class="coming-soon-label">Recap Coming Soon</p>
        <p>Photos and highlights from the weekend are on the way &mdash; check back soon!</p>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container" style="text-align: center;">
      <a href="/" class="btn btn-ghost">Back to Home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .past-hackathon-hero {
    padding-bottom: 1rem;
  }

  .recap-placeholder {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    padding: 2.5rem 2rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
  }

  .recap-placeholder p:last-child {
    color: var(--color-text-muted);
  }

  .coming-soon-label {
    display: inline-block;
    background: var(--color-accent-dim);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3em 0.8em;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }
</style>
