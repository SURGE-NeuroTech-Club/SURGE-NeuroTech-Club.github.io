---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalendarEmbed from '../components/CalendarEmbed.astro';
---

<BaseLayout>
  <!-- ============================================================
       Hero
       ============================================================ -->
  <section class="hero">
    <div class="container">
      <p class="hero-eyebrow">SURGE Innovation &bull; Dalhousie University</p>
      <h1>Welcome to the<br /><span>SURGE NeuroTech Club</span></h1>
      <p class="hero-sub">
        A community of neuro-enthusiasts dedicated to exploring, understanding,
        and innovating in the field of neurotechnology.
      </p>
      <div class="notice-banner">
        The club is on pause for the summer and will return in September with a new schedule.
      </div>
      <div class="hero-meta">
        📅&nbsp; Starting September &nbsp;&bull;&nbsp; Mondays&nbsp;2:30&ndash;4:00&nbsp;PM &amp; Thursdays&nbsp;12:30&ndash;2:00&nbsp;PM &nbsp;&bull;&nbsp; LSC Room O2660
      </div>
      <div class="hero-actions">
        <a href="#calendar" class="btn btn-accent">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          Find Our Next Meeting
        </a>
        <a href="https://form.typeform.com/to/lImdjPTV?typeform-source=www.surgeinnovation.ca" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          Join Mailing List
        </a>
        <a href="https://github.com/SURGE-NeuroTech-Club" target="_blank" rel="noopener noreferrer" class="btn btn-accent">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       About
       ============================================================ -->
  <section class="section about-section">
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <h2>Who We Are</h2>
          <p>
            We are the Dalhousie/SURGE NeuroTech Club! Our goal is to help students
            with <em>any</em> level of neuroscience or coding experience get engaged
            and excited about neurotechnology.
          </p>
          <p>
            The club is <span class="highlight">drop-in and completely free</span> to
            attend. Whether you're a complete beginner or an experienced researcher,
            you're welcome to join us.
          </p>
          <p>
            For general inquiries email&nbsp;
            <a href="mailto:NeuroTechClub@dal.ca">NeuroTechClub@dal.ca</a>.
            For specific neurotech questions, reach out to our programming
            specialist&nbsp;<a href="#team">Max</a>.
          </p>

          <div style="margin-top: 2rem;">
            <div class="info-card">
              <div class="info-card-label">When</div>
              <div class="info-card-value">
                On pause until September.<br />
                Starting September: Mondays 2:30&ndash;4:00&nbsp;PM &amp; Thursdays 12:30&ndash;2:00&nbsp;PM
              </div>
            </div>
            <div class="info-card">
              <div class="info-card-label">Where</div>
              <div class="info-card-value">Life Sciences Centre, Room O2660 (Oceanography wing)</div>
            </div>
            <div class="info-card">
              <div class="info-card-label">Cost</div>
              <div class="info-card-value">Free &mdash; no registration required</div>
            </div>
          </div>
        </div>

        <div class="about-text">
          <h2>How to Find Us</h2>

          <img
            src="/images/maps_location1.PNG"
            alt="Map showing location of SURGE NeuroTech Club in the Life Sciences Centre"
            style="border-radius: 12px; border: 1px solid var(--color-border); width: 100%; margin: 1.25rem 0;"
          />

          <div style="display: flex; gap: 1.5rem; align-items: flex-start;">
            <div style="flex: 1; min-width: 0;">
              <p style="margin-bottom: 0.75rem;">
                <strong>From the main LSC entrance:</strong>
                Take the stairs on the right, walk past Tim Hortons, exit through the doors on your right.
                Enter the building across from you, walk straight until you see bathrooms on your left or
                the SURGE A-frame sign, then head through the doors on your right.
              </p>
              <p style="margin: 0;">
                <strong>Wheelchair access:</strong>
                Start at Wickwire Field and walk beside the LSC toward Oxford Street,
                passing between the LSC and Shirreff Hall. The ramp is just beyond the
                bike locks, after the playground and LSC courtyard.
              </p>
            </div>
            <div style="flex-shrink: 0; width: 180px; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
              <video
                controls
                muted
                playsinline
                title="How to find NeuroTech Club"
                style="border-radius: 10px; width: 100%;"
              >
                <source src="/images/How_to_find_NTC_Video.mp4" type="video/mp4" />
              </video>
              <p style="font-size: 0.8rem; text-align: center; margin: 0;">How to find us</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       Calendar
       ============================================================ -->
  <section id="calendar" class="section calendar-section" style="background: var(--color-bg-secondary); scroll-margin-top: var(--nav-height);">
    <div class="container">
      <div class="section-heading">
        <h2>Upcoming Events</h2>
        <p>Stay up to date with club meetings, workshops, and events</p>
      </div>
      <CalendarEmbed />
    </div>
  </section>

  <!-- ============================================================
       Team
       ============================================================ -->
  <section class="section" id="team">
    <div class="container">
      <div class="section-heading">
        <h2>Our Team</h2>
        <p>The people behind the club</p>
      </div>
      <div style="max-width: 720px; margin: 0 auto;">
        <div class="team-card">
          <img
            src="/images/Max_SURGE_pic.jpg"
            alt="Max Mascini"
            class="team-avatar"
          />
          <div class="team-info">
            <h3>Max Mascini</h3>
            <span class="team-role">NeuroTech Programming Specialist</span>
            <p class="team-bio-text">
              Max is a dedicated Neurotech Programming Specialist at SURGE, where he utilizes his
              extensive research experience with brain-computer interfaces (BCIs) to engage students
              in learning, ideating, and creating innovative neurotechnology solutions. With a
              background in both neuroscience and computer science, Max plays a crucial role in
              fostering student involvement with neurotechnology in an interactive and supportive
              environment.
            </p>
            <a href="mailto:Mascini.Max@dal.ca" style="font-size:0.875rem; margin-top:0.5rem; display:inline-block;">
              Mascini.Max@dal.ca
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function easeInOutQuad(t: number) {
    return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
  }

  document.querySelector('a[href="#calendar"]')?.addEventListener('click', (e) => {
    const target = document.getElementById('calendar');
    if (!target) return;
    e.preventDefault();

    const navHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-height')) || 64;
    const startY = window.scrollY;
    const endY = target.getBoundingClientRect().top + startY - navHeight;
    const distance = endY - startY;
    const duration = 700;
    let startTime: number | null = null;

    function step(timestamp: number) {
      if (startTime === null) startTime = timestamp;
      const elapsed = timestamp - startTime;
      const progress = Math.min(elapsed / duration, 1);
      window.scrollTo(0, startY + distance * easeInOutQuad(progress));
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  });
</script>
